# Основные настройки системы
DOMAIN_NAME=example.com
ADMIN_EMAIL=admin@example.com

# Настройки WordPress
WP_DB_NAME=wordpress
WP_DB_USER=wp_user
WP_DB_PASSWORD=secure_password_123
WP_DB_ROOT_PASSWORD=root_password_123
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin_password_123
WP_TITLE="My WordPress Site"

# Настройки Cloudflare
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_zone_id
CLOUDFLARE_EMAIL=your_cloudflare_email

# Настройки автоматизации контента
CONTENT_AUTOMATION_ENABLED=true
CONTENT_API_KEY=your_content_api_key

# Настройки мониторинга
GRAFANA_ADMIN_PASSWORD=grafana_admin_password
PROMETHEUS_RETENTION=15d

# Настройки сети
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# Настройки SSL
LETSENCRYPT_EMAIL=ssl@example.com
SSL_STAGING=false

# Настройки бекапа
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret

# Настройки безопасности
FAIL2BAN_ENABLE=true
UFW_ENABLE=true
SSH_PORT=22